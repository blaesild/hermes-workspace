legacy-peer-deps=true
# Approve build scripts needed for the server build. esbuild compiles its native
# binary on install. The Electron-related packages are for the desktop app build
# (electron:build script) and not needed for the server-only `pnpm build` path —
# but we approve them too so the Docker build succeeds without error. They're
# no-ops in headless Linux containers.
onlyBuiltDependencies[]=esbuild
onlyBuiltDependencies[]=electron
onlyBuiltDependencies[]=electron-winstaller
onlyBuiltDependencies[]=unrs-resolver
